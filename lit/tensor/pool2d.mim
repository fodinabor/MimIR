// RUN: rm -f %{s:stem}.ll
// RUN: %mim -p opt %s -p direct -p affine -p ll -o -
// RUN: %FileCheck %s < %{s:stem}.ll

plugin core;
plugin tensor;
plugin affine;
plugin mem;
plugin math;

let F32 = %math.F32;

fun avg_step (acc: F32, x: F32)@tt : F32 =
    return (%math.arith.div 0 (%math.arith.add 0 (acc, x), 4.0:F32));

fun max_step (acc: F32, x: F32)@tt : F32 =
    return (%math.extrema.iM 0 (acc, x));

lam avg_out (oh ow kh kw: %affine.index): «2; %affine.index» = (oh, ow);
lam avg_in (oh ow kh kw: %affine.index): «2; %affine.index» =
    (%affine.op.add (%affine.semiop.mul (oh, 2), kh),
     %affine.op.add (%affine.semiop.mul (ow, 2), kw));

lam max_out (oh ow kh kw: %affine.index): «2; %affine.index» = (oh, ow);
lam max_in (oh ow kh kw: %affine.index): «2; %affine.index» =
    (%affine.op.add (%affine.semiop.mul (oh, 2), kh),
     %affine.op.add (%affine.semiop.mul (ow, 2), kw));

fun extern avgpool2d_4x4 (input: «4, 4; F32»): «3, 3; F32» =
    let padded = %tensor.pad @(F32, 2) (4, 4) (0, (1, 1), (1, 1)) (input, 0:F32);
    return (%tensor.map_reduce_aff @1 @(F32, 2, 2) ((3, 3), (3, 3, 2, 2))
                @(F32, 2, (6, 6))
                (avg_step, 0:F32)
                avg_out avg_in
                padded);

fun extern maxpool2d_4x4 (input: «4, 4; F32»): «3, 3; F32» =
    let padded = %tensor.pad @(F32, 2) (4, 4) (0, (1, 1), (1, 1)) (input, 0xFF800000 : F32);
    return (%tensor.map_reduce_aff @1 @(F32, 2, 2) ((3, 3), (3, 3, 2, 2))
                @(F32, 2, (6, 6))
                (max_step, 0xFF800000 : F32)
                max_out max_in
                padded);

// CHECK-DAG: @avgpool2d_4x4
// CHECK-DAG: @maxpool2d_4x4
// CHECK-NOT: %tensor.window_reduce2d
// CHECK-NOT: %tensor.pad
