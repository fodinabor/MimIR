// RUN: %mim -p opt %s -p direct -p affine -o - | %FileCheck %s
plugin core;
plugin tensor;
plugin affine;
plugin compile;

// CHECK-DAG: fun extern gather1d
fun extern gather1d (input: «4; I32», index: «2; Idx 4»): «2; I32» =
    return (%tensor.gather @(I32, 1) (4, 2) 0_1 (input, index));

// CHECK-DAG: fun extern gather2d
fun extern gather2d (input: «2, 3; I32», index: «2, 2; Idx 3»): «2, 2; I32» =
    return (%tensor.gather @(I32, 2) ((2, 3), (2, 2)) 1_2 (input, index));

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup_phase,
        %tensor.lower_tensor,
        %tensor.lower_map_reduce,
        %compile.internal_cleanup_phase,
    );
