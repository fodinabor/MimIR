// RUN: %mim -p opt %s -o - | %FileCheck %s

// Fused map_reduce over a symbolic outer extent `n`.
// This checks that fusion and lowering still work when the shape is not fully literal.
plugin tensor;
plugin core;
plugin opt;

lam add1 (x: Nat): Nat = %core.nat.add (x, 1);
lam mul2 (x: Nat): Nat = %core.nat.mul (x, 2);

fun sum_reduce (acc x: Nat)@tt: Nat = return (%core.nat.add (acc, x));

fun fused_nested{n: Nat} (v: «n; «3; Nat»»): «n; Nat» =
    let inner1 = %tensor.unary @(Nat, Nat) add1 @(2, (n, 3)) v;
    let inner2 = %tensor.unary @(Nat, Nat) mul2 @(2, (n, 3)) inner1;
    let outer  = %tensor.map_reduce @1 @(Nat, 1, 1) (n, (n, 3)) @(Nat, 2, (n, 3)) (sum_reduce, 0)
        (%tensor.proj_map @(2, 1) 0)
        (%tensor.proj_map @(2, 2) (0, 1),)
        inner2;
    return outer;

fun extern f(v: «2; «3; Nat»»): «2; Nat» =
    ret out = fused_nested @2 $ v;
    return out;

lam extern _compile (): %compile.Phase =
    %compile.phases ff (
        %compile.internal_cleanup,
        %tensor.lower_tensor,
        %tensor.fuse_tensor,
        %compile.internal_cleanup,
    );

// CHECK: %tensor.map_reduce
// CHECK-NOT: %tensor.map_reduce
